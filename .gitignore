# ===== Secrets / env =====
# .env (no slash) matches at any depth; .env.example stays tracked
.env
*.env.local
backend/.env

# ===== Python =====
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# App data (uploaded files & generated results)
backend/storage/

# ===== Node / frontend =====
node_modules/
dist/
.vite/
*.tsbuildinfo
# emitted by `tsc -b` (the real source is vite.config.ts)
frontend/vite.config.js
frontend/vite.config.d.ts

# ===== Editors / OS =====
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ===== Logs =====
*.log
logs/

# Claude Code local settings (per-machine permissions, never commit)
.claude/settings.local.json
