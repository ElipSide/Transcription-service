# ===== docker compose configuration =====
# Copy to .env and adjust. SECRET_KEY is required.

# Web (host port for the React/nginx frontend)
WEB_PORT=8095
# Public sub-path the app is served under (must end with /). Use "/" for root.
WEB_BASE=/transcribe/

# PostgreSQL
POSTGRES_USER=transcribe
POSTGRES_PASSWORD=transcribe
POSTGRES_DB=transcribe

# JWT signing secret (REQUIRED). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# DiarService (recognition/diarization). Port 8443 is HTTPS, cert is self-signed.
DIAR_BASE_URL= 
DIAR_WS_URL= 
DIAR_VERIFY_SSL=false

# DeepSeek (for "report" / "ai_extract" modes). Leave empty to skip AI reports.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Upload limit (bytes). Default 2 GB.
MAX_FILE_SIZE=2147483648

# Allowed CORS origin(s) of the frontend
CORS_ORIGINS=http://localhost:8095
