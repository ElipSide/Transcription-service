# ===== Database =====
DATABASE_URL=postgresql+asyncpg://transcribe:transcribe@localhost:5432/transcribe

# ===== Auth / JWT =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== DiarService (recognition/diarization backend) =====
# Port 8443 is HTTPS (nginx). Cert is self-signed -> DIAR_VERIFY_SSL=false.
DIAR_BASE_URL=https://109.202.9.107:8443/diaraudio
DIAR_WS_URL=wss://109.202.9.107:8443/diaraudio
DIAR_UPLOAD_TIMEOUT=360
DIAR_VERIFY_SSL=false

# ===== DeepSeek (reports) =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Storage / uploads =====
STORAGE_DIR=storage
MAX_FILE_SIZE=2147483648          # 2 GB
CHUNK_DIR=storage/chunks

# ===== ffmpeg =====
FFMPEG_BIN=ffmpeg

# ===== CORS (comma-separated origins for the React dev server / prod domain) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
